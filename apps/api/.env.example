# ── Server ──
HOST=0.0.0.0
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug

# ── Database ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gigsge
DB_USER=postgres

# ── Redis ──
REDIS_URL=redis://localhost:6379

# ── Authentication email queue (Cloud Tasks; leave unset for local _dev codes) ──
GCP_PROJECT_ID=
AUTH_EMAIL_TASK_LOCATION=us-central1
AUTH_EMAIL_TASK_QUEUE=
AUTH_EMAIL_TASK_TARGET_URL=

# ── JWT ──
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Photo storage (Google Cloud Storage) ──
# Leave empty locally: photo uploads then answer 503. To test uploads locally, set a bucket
# and run `gcloud auth application-default login` so the API can use your credentials.
MEDIA_BUCKET=

# ── Email (Resend) ──
RESEND_API_KEY=
EMAIL_FROM=noreply@gigs.ge

# ── Frontend URL (CORS) ──
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002
